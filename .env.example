# 複製成 .env 後，把每個 change-me 都換成你自己的強密碼／隨機字串。
# .env 已列在 .gitignore，不會進版控；這個範本檔裡不要放真正的密碼。
#
# 產生隨機字串的方法（任選一種）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
# 密碼裡請避開 @ : / " ' 這幾個字元（它們會被拼進資料庫連線字串或 shell 指令）。

# ── TimescaleDB ──
TIMESCALEDB_USER=iiot
TIMESCALEDB_PASSWORD=change-me
TIMESCALEDB_DB=iiot
# 注意：這個密碼只在資料卷第一次建立時生效。已經有舊資料卷的話，要嘛先沿用舊密碼，
# 要嘛到資料庫裡改成新密碼，再更新這裡：
#   docker compose exec timescaledb psql -U iiot -d iiot -c "ALTER USER iiot PASSWORD '新密碼';"

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=change-me
# 注意：一樣只在 grafana_data 資料卷第一次建立時生效。已經有舊資料卷的話用這行重設：
#   docker compose exec grafana grafana cli admin reset-admin-password 新密碼

# ── MQTT（外部裝置進線用的帳密，mosquitto 每次啟動都會照這裡重新產生密碼檔）──
MQTT_USERNAME=iiot
MQTT_PASSWORD=change-me
# 裝置送來的字串時間戳沒有帶時區時，當成哪個時區（IANA 名稱，例如 Asia/Taipei、UTC）
MQTT_NAIVE_TIMESTAMP_TZ=Asia/Taipei

# ── 危險模式控制 API（port 8080）──
# POST 類操作都要帶 Authorization: Bearer <這個 token>
CONTROL_API_TOKEN=change-me

# ── 對外綁定位址（預設只有本機連得到；要開放給別台機器才改成 0.0.0.0）──
# DB_BIND_ADDR=127.0.0.1
# CONTROL_API_BIND_ADDR=127.0.0.1

  "panels": [
    {
      "id": 50,
      "type": "timeseries",
      "title": "CPU 使用率",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", cpu_percent AS \"CPU%\" FROM system_health WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 51,
      "type": "timeseries",

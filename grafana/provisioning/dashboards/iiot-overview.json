    {
      "id": 400,
      "type": "row",
      "title": "Phase3 AI 剩餘壽命預測（RUL，電流均值+飄移趨勢外推）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "type": "table",
      "title": "電流均值 RUL 預測（各相，依緊急程度排序）",
      "description": "STABLE=沒有顯著飄移趨勢；WARNING=預估30分鐘內觸及電流上/下限；CRITICAL=預估5分鐘內。eta_seconds為預估還要幾秒觸及門檻。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STABLE": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "WARNING": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "eta_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "current_mean"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "drift_rate_per_min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT device_id, sensor_id, current_mean, drift_rate_per_min, target_threshold, eta_seconds, status\nFROM (\n  SELECT DISTINCT ON (device_id, sensor_id)\n    device_id, sensor_id, current_mean, drift_rate_per_min, target_threshold, eta_seconds, status, ts\n  FROM rul_predictions WHERE metric_kind = 'current_mean'\n  ORDER BY device_id, sensor_id, ts DESC\n) latest\nORDER BY CASE status WHEN 'CRITICAL' THEN 0 WHEN 'WARNING' THEN 1 ELSE 2 END, eta_seconds NULLS LAST",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 500,
      "type": "row",
      "title": "Phase3 AI 振動頻譜預測（RUL + 異常分數 + CUSUM 漸進劣化）",
      "collapsed": false,
      "gridPos": {

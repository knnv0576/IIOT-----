    {
      "id": 60,
      "type": "table",
      "title": "振動 ML RUL 預測（RF 模型，依緊急程度排序）",
      "description": "由 32 顆真實軸承 run-to-failure 資料訓練的 RandomForest 模型直接輸出剩餘壽命（分鐘），特徵為 rms_norm（現值/健康基線）、kurtosis、crest factor、rms 斜率。STABLE=RUL≥200分；WARNING=<200分；CRITICAL=<60分。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STABLE": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "WARNING": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rul_min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rms_norm"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rms_slope_per_min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT device_id, sensor_id, current_mean AS rms_norm, drift_rate_per_min AS rms_slope_per_min,\n       round((eta_p10_seconds/60)::numeric, 0) AS \"RUL_P10(悲觀)\",\n       round((eta_seconds/60)::numeric, 0) AS rul_min,\n       round((eta_p90_seconds/60)::numeric, 0) AS \"RUL_P90(樂觀)\", status\nFROM (\n  SELECT DISTINCT ON (device_id, sensor_id)\n    device_id, sensor_id, current_mean, drift_rate_per_min, eta_seconds,\n    eta_p10_seconds, eta_p90_seconds, status, ts\n  FROM rul_predictions WHERE metric_kind = 'ml_rf'\n  ORDER BY device_id, sensor_id, ts DESC\n) latest\nORDER BY CASE status WHEN 'CRITICAL' THEN 0 WHEN 'WARNING' THEN 1 ELSE 2 END, rul_min NULLS LAST",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "振動 ML RUL 倒數趨勢 + 信賴區間 — $device（X軸，分鐘）",
      "description": "RandomForest 輸出的剩餘壽命隨時間變化；健康時高、劣化時應一路下降。實線=點估計，虛線=P10(悲觀)/P90(樂觀) 信賴區間（ISO 13381-1 要求預後須附信賴區間）。實測本模型相對誤差 60~70%，區間寬度就是這個不確定性的視覺化——請依 P10 安排保養，不要咬住點估計。橘線=200分(WARNING)、紅線=60分(CRITICAL)。",
      "datasource": {
        "type": "grafana-postgresql-datasource",

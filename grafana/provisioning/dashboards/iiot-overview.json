  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "機台狀態即時圖表（$device）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "溫度 — $device",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", value AS \"溫度\"\nFROM sensor_readings\nWHERE device_id = '$device'\n  AND sensor_id = 'T' || (split_part('$device','-',2))::int::text\n  AND $__timeFilter(ts)\nORDER BY ts",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "電流三相 (A/B/C) — $device",
      "description": "圖例可點擊：點一下某一相只顯示該相、再點一下恢復全部。1秒彙總後60Hz正弦波已被平均抵消，三相看起來接近是正常現象。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket AS \"time\", sensor_id AS \"metric\", avg_value AS value\nFROM current_1s_agg\nWHERE device_id = '$device' AND $__timeFilter(bucket)\nORDER BY bucket",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "三軸合成振動 vs ISO 門檻 — $device",
      "description": "綠=優良上限、黃=可接受上限、紅=危險門檻（依機台 Class 自動對應）。圖例可點擊單獨顯示某一條線。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymms",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "優良上限"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "可接受上限"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "危險門檻"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "合成振動"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  v.bucket AS \"time\",\n  sqrt(v.x*v.x + v.y*v.y + v.z*v.z) AS \"合成振動\",\n  t.good_upper AS \"優良上限\",\n  t.acceptable_upper AS \"可接受上限\",\n  t.danger_lower AS \"危險門檻\"\nFROM vibration_1s_agg v\nCROSS JOIN (\n  SELECT good_upper, acceptable_upper, danger_lower\n  FROM machine_vibration_thresholds WHERE device_id = '$device'\n) t\nWHERE v.device_id = '$device' AND $__timeFilter(v.bucket)\nORDER BY v.bucket",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "AI 即時警報（$device，門檻規則版，待接 Phase3 AI 推論）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "即時異常警報 — $device",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NORMAL",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✅ NORMAL",
                  "color": "green"
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "CRITICAL.*",
                "result": {
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  CASE WHEN COALESCE(max(sqrt(g.x*g.x + g.y*g.y + g.z*g.z)), 0) > max(t.danger_lower)\n       THEN 'CRITICAL: $device Vibration Exceeded Limit!'\n       ELSE 'NORMAL' END AS \"狀態\"\nFROM (\n  SELECT ts,\n         max(value) FILTER (WHERE sensor_id LIKE '%-X') AS x,\n         max(value) FILTER (WHERE sensor_id LIKE '%-Y') AS y,\n         max(value) FILTER (WHERE sensor_id LIKE '%-Z') AS z\n  FROM sensor_readings\n  WHERE device_id = '$device' AND sensor_id LIKE 'V%' AND ts > now() - INTERVAL '10 seconds'\n  GROUP BY ts\n) g\nCROSS JOIN (\n  SELECT danger_lower FROM machine_vibration_thresholds WHERE device_id = '$device'\n) t",
          "rawQuery": true
        }
      ]
    },
    {

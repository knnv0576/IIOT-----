    {
      "id": 50,
      "type": "table",
      "title": "振動頻譜 RUL 預測（追蹤 thd_ratio 外推撞 0.05，各軸）",
      "description": "追蹤諧波比值 thd_ratio 的上升趨勢外推到劣化門檻 0.05。STABLE=無顯著上升；WARNING=預估30分內觸及；CRITICAL=預估5分內。這是振幅還看不出來時就能預測壽命的關鍵。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STABLE": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "WARNING": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "eta_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "thd_ratio"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "thd_per_min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 6
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT device_id, sensor_id, current_mean AS thd_ratio, drift_rate_per_min AS thd_per_min,\n       target_threshold, eta_seconds, status\nFROM (\n  SELECT DISTINCT ON (device_id, sensor_id)\n    device_id, sensor_id, current_mean, drift_rate_per_min, target_threshold, eta_seconds, status, ts\n  FROM rul_predictions WHERE metric_kind = 'thd_ratio'\n  ORDER BY device_id, sensor_id, ts DESC\n) latest\nORDER BY CASE status WHEN 'CRITICAL' THEN 0 WHEN 'WARNING' THEN 1 ELSE 2 END, eta_seconds NULLS LAST",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "振動 thd_ratio 頻譜劣化趨勢 — $device（三軸）",
      "description": "諧波比值隨時間上升代表頻譜劣化；紅線=劣化門檻 0.05。振幅不變時這裡就會先動。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "decimals": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", thd_ratio AS value, sensor_id AS metric\nFROM anomaly_scores\nWHERE device_id = '$device' AND sensor_id LIKE 'V%' AND thd_ratio IS NOT NULL\n  AND $__timeFilter(ts)\nORDER BY ts"
        }
      ]
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "振動 CUSUM 漸進劣化累積 — $device（三軸）",
